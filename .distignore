# Files and folders excluded from the distributed plugin ZIP.
# These live in the repo (and, for directory assets, in SVN /assets/) but
# must not ship inside the plugin itself.

# Directory assets — belong in WP.org SVN /assets/, not the plugin
.wordpress-org

# Version control & editor cruft
.git
.github
.gitignore
.DS_Store
.idea
.vscode

# Dev-only docs (readme.txt is the shipped WP.org readme)
README.md
CHANGELOG.md

# Raw source screenshots (listing screenshots live in SVN /assets/)
screenshots

# Dependencies: the runtime ones ship prefixed in vendor-prefixed/; vendor/ is dev tooling only.
# composer.json ships (WordPress.org asks for it next to Composer-built code); the lock does not.
vendor
composer.lock

# Tests and dev environment
tests
phpunit.xml.dist
phpunit-integration.xml.dist
.phpunit.result.cache
.phpunit.cache
.wp-env.json
.wp-env.override.json

# Build and release tooling
build.sh
bin
.distignore
build
